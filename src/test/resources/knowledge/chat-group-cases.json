{
  "description": "22 authored R32D catalog-group scenarios; preserve first result before tuning",
  "cases": [
    {
      "id": "01",
      "group": "catalog-group",
      "setup": [
        "Найди Ryzen"
      ],
      "message": "Кто из них дешевле?",
      "expect": {
        "productIds": [
          6
        ]
      }
    },
    {
      "id": "02",
      "group": "catalog-group",
      "setup": [
        "Найди Ryzen"
      ],
      "message": "Покажи самый дорогой из этих",
      "expect": {
        "productIds": [
          10
        ]
      }
    },
    {
      "id": "03",
      "group": "catalog-group",
      "setup": [
        "Собери ПК до 100000 рублей для игр",
        "Найди Ryzen"
      ],
      "message": "Какой из них самый дешёвый?",
      "expect": {
        "productIds": [
          6
        ],
        "budget": 100000
      }
    },
    {
      "id": "04",
      "group": "catalog-group",
      "setup": [
        "Найди Ryzen"
      ],
      "message": "Что из показанного есть в наличии?",
      "expect": {
        "productIds": [
          6,
          7,
          8,
          9,
          10
        ]
      }
    },
    {
