<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" hbarPolicy="NEVER" stylesheets="@styles/theme.css, @styles/shell.css">
  <VBox spacing="24" styleClass="catalog-page">
    <Button fx:id="backButton" text="К каталогу" styleClass="btn-ghost"/>
    <HBox spacing="30" styleClass="detail-surface">
      <StackPane prefWidth="300" minWidth="180" prefHeight="260" styleClass="product-image"><ImageView fx:id="productImage" fitWidth="280" fitHeight="240" preserveRatio="true"/></StackPane>
      <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="0">
        <Label fx:id="productCategory" text="Комплектующие" styleClass="eyebrow"/><Label fx:id="productName" text="Карточка товара" wrapText="true" styleClass="page-title"/>
        <Label fx:id="productManufacturer" text="Производитель" styleClass="text-muted"/><Label fx:id="productPrice" text="Цена" styleClass="detail-price"/>
        <Button fx:id="addToCartButton" text="В корзину" styleClass="btn-primary"/>
        <Separator/><Label text="Описание" styleClass="section-title"/><Label fx:id="productDescription" text="Описание пока не добавлено." wrapText="true" styleClass="detail-description"/>
      </VBox>
    </HBox>
  </VBox>
</ScrollPane>
