<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminController" styleClass="secondary-page" stylesheets="@styles/theme.css, @styles/secondary.css">
 <top><VBox spacing="10" styleClass="secondary-page-heading"><Label text="РАБОЧЕЕ ПРОСТРАНСТВО" styleClass="secondary-eyebrow"/><HBox alignment="CENTER_LEFT" spacing="14"><Label text="Администрирование" styleClass="page-title"/></HBox><Label fx:id="screenStatus" text="Товары, пользователи, заказы и промокоды" wrapText="true" styleClass="page-subtitle"/></VBox></top>
 <center><TabPane fx:id="adminTabs" tabClosingPolicy="UNAVAILABLE" styleClass="secondary-tabs">
   <Tab text="Товары"><VBox spacing="16" styleClass="secondary-table-page"><HBox spacing="14" alignment="CENTER_LEFT"><Label text="Управление ассортиментом" styleClass="secondary-section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="addProductBtn" text="Добавить товар" styleClass="btn, btn-primary"/></HBox><TableView fx:id="productsTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Нет товаров для отображения" styleClass="secondary-muted"/></placeholder></TableView></VBox></Tab>
   <Tab text="Пользователи"><VBox spacing="16" styleClass="secondary-table-page"><HBox spacing="14" alignment="CENTER_LEFT"><Label text="Пользователи" styleClass="secondary-section-title"/><Region HBox.hgrow="ALWAYS"/><TextField fx:id="userSearchField" promptText="Поиск по email, имени или фамилии" prefWidth="300"/></HBox><TableView fx:id="usersTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Нет пользователей для отображения" styleClass="secondary-muted"/></placeholder></TableView></VBox></Tab>
   <Tab text="Заказы"><VBox spacing="16" styleClass="secondary-table-page"><HBox spacing="14" alignment="CENTER_LEFT"><Label text="История заказов" styleClass="secondary-section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Статус" styleClass="field-label"/><ComboBox fx:id="orderStatusFilter" prefWidth="160"/></HBox><TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Заказов пока нет" styleClass="secondary-muted"/></placeholder></TableView></VBox></Tab>
   <Tab text="Промокоды"><VBox spacing="16" styleClass="secondary-table-page"><HBox spacing="14" alignment="CENTER_LEFT"><Label text="Промокоды и ограничения" styleClass="secondary-section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="addPromoCodeBtn" text="Создать промокод" styleClass="btn, btn-primary"/></HBox><TableView fx:id="promoCodesTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Промокодов пока нет" styleClass="secondary-muted"/></placeholder></TableView></VBox></Tab>
 </TabPane></center>
</BorderPane>
