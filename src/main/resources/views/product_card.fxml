<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="8" prefWidth="260" minWidth="180" prefHeight="330" styleClass="product-card" stylesheets="@styles/theme.css, @styles/shell.css">
  <StackPane prefHeight="150" styleClass="product-image"><ImageView fx:id="productImage" fitWidth="220" fitHeight="140" preserveRatio="true"/></StackPane>
  <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="product-copy">
    <Label fx:id="productManufacturer" text="Производитель" styleClass="product-category"/>
    <Label fx:id="productName" text="Название товара" wrapText="true" styleClass="section-title"/>
    <Region VBox.vgrow="ALWAYS"/>
    <Label fx:id="productPrice" text="Цена" styleClass="product-price"/>
    <HBox spacing="8"><Button fx:id="detailsButton" text="Подробнее" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn"/><Button fx:id="addToCartButton" text="В корзину" styleClass="btn-primary"/></HBox>
  </VBox>
</VBox>
