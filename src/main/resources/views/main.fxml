<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController" fx:id="shellRoot" styleClass="app-root" stylesheets="@styles/theme.css, @styles/shell.css">
  <HBox>
    <VBox fx:id="categoryPane" styleClass="shell-sidebar" prefWidth="220" minWidth="180" maxWidth="220">
      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="shell-brand"><Label text="t" styleClass="brand-mark"/><Label text="TechStore." styleClass="brand-name"/></HBox>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" minHeight="0" styleClass="nav-scroll"><VBox spacing="5" minWidth="0">
      <Label text="ВАШ КОМПЬЮТЕР" styleClass="nav-section"/>
      <Button fx:id="catalogBtn" text="Каталог" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      <Button fx:id="configuratorBtn" text="Конфигуратор" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      <Button fx:id="chatBtn" text="Помощник" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      <Separator styleClass="nav-separator"/>
      <Button fx:id="cartBtn" text="Корзина" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      <Button fx:id="profileBtn" text="Личный кабинет" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      <VBox fx:id="staffNav" spacing="4" visible="false" managed="false">
        <Separator styleClass="nav-separator"/><Label text="УПРАВЛЕНИЕ" styleClass="nav-section"/>
        <Button fx:id="managerBtn" text="Товары" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
        <Button fx:id="adminBtn" text="Админ-панель" maxWidth="Infinity" styleClass="nav-item" wrapText="true"/>
      </VBox>
      </VBox></ScrollPane>
      <VBox fx:id="sidebarHelp" spacing="9" styleClass="sidebar-help"><Label text="Не знаете, с чего начать?" wrapText="true" styleClass="help-title"/><Label text="Поможем выбрать детали под ваши задачи." wrapText="true" styleClass="text-muted"/><Button text="Открыть чат" onAction="#openChat" styleClass="btn-ghost, btn-small"/></VBox>
      <HBox spacing="6" alignment="CENTER_LEFT" styleClass="sidebar-footer"><Label text="TechStore"/><Region HBox.hgrow="ALWAYS"/><Label text="Собрано под вас"/></HBox>
    </VBox>
    <BorderPane fx:id="mainPane" HBox.hgrow="ALWAYS" minWidth="0">
      <top><HBox fx:id="headerPane" styleClass="shell-header" alignment="CENTER_LEFT" spacing="20">
        <Label text="Магазин" styleClass="breadcrumb-muted"/><Label text="/" styleClass="breadcrumb-muted"/><Label fx:id="sectionName" text="Каталог" styleClass="breadcrumb-current"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="searchBox" prefHeight="40" minHeight="40" maxHeight="40" alignment="CENTER_LEFT" spacing="8" styleClass="shell-search"><TextField fx:id="searchField" promptText="Поиск комплектующих" HBox.hgrow="ALWAYS"/></HBox>
        <Separator orientation="VERTICAL" prefHeight="24"/><Button fx:id="accountBtn" text="Гость" styleClass="account-button"/>
      </HBox></top>
    </BorderPane>
  </HBox>
  <Label fx:id="toastLabel" visible="false" managed="false" wrapText="true" maxWidth="450" styleClass="shell-toast" StackPane.alignment="BOTTOM_RIGHT"><StackPane.margin><Insets right="24" bottom="24"/></StackPane.margin></Label>
</StackPane>
