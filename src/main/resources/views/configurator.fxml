<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="configuratorRoot" fx:controller="controllers.ConfiguratorController"
           styleClass="configurator-root" stylesheets="@styles/theme.css, @styles/configurator.css">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="config-page-scroll">
        <VBox fx:id="mainContent" styleClass="config-page" spacing="23">
            <HBox spacing="18" alignment="CENTER_LEFT">
                <VBox spacing="9" HBox.hgrow="ALWAYS">
                    <Label text="КОНФИГУРАТОР" styleClass="eyebrow"/>
                    <Label text="Ваша сборка — деталь за деталью" styleClass="page-title" wrapText="true"/>
                    <Label text="Выбирайте комплектующие. Мы поможем заметить ограничения." styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <Button text="Помочь с выбором" onAction="#askForHelp" styleClass="btn, btn-soft"/>
            </HBox>
            <GridPane fx:id="configColumns" hgap="24" vgap="24">
                <VBox fx:id="listColumn" spacing="15" minWidth="0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="selectedCount" text="0 из 8 компонентов" styleClass="badge, config-count"/>
                        <Label text="Системный блок" styleClass="config-system-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="clearBuildButton" text="Очистить" onAction="#clearBuild" styleClass="config-clear-button"/>
                    </HBox>
                    <VBox fx:id="categoriesContainer" spacing="9"/>
                    <Label text="Корпус и охлаждение включены в сборку. Неизвестные данные не подтверждают совместимость." wrapText="true" styleClass="config-bottom-note"/>
                    <ListView fx:id="componentsList" visible="false" managed="false"/>
                </VBox>
                <VBox fx:id="summaryColumn" spacing="20" minWidth="0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <VBox styleClass="surface, config-summary" spacing="15">
                        <Label text="Сводка сборки" styleClass="config-summary-title"/>
                        <HBox fx:id="cartStatusBox" visible="false" managed="false" styleClass="config-cart-status">
                            <Label fx:id="cartStatusText" wrapText="true" HBox.hgrow="ALWAYS" minWidth="0"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Ваш бюджет" styleClass="text-muted"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="budgetValue" text="Не задан" styleClass="config-budget-value"/>
                        </HBox>
                        <ProgressBar fx:id="budgetProgress" visible="false" managed="false" maxWidth="Infinity" styleClass="config-budget-progress"/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="budgetRemainderLabel" text="Укажите бюджет для сравнения" styleClass="config-summary-label" wrapText="true"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="remainingBudget" text="—" styleClass="config-budget-remaining"/>
                        </HBox>
                        <Separator/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="К покупке" styleClass="config-total-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="totalPrice" text="0 ₽" styleClass="config-total-price"/>
                        </HBox>
                        <HBox fx:id="compatStatusBox" styleClass="config-status, config-status-unknown">
                            <VBox spacing="8" HBox.hgrow="ALWAYS" minWidth="0">
                                <Label fx:id="compatTitle" text="Нужна проверка характеристик" styleClass="config-status-title" wrapText="true"/>
                                <Label fx:id="compatStatusText" text="Выберите компоненты для проверки." styleClass="config-status-text" wrapText="true"/>
                            </VBox>
                        </HBox>
                        <ComboBox fx:id="buildUsage" maxWidth="Infinity"/>
                        <Button fx:id="completeBuildButton" text="Подобрать остальные" onAction="#completeBuild" maxWidth="Infinity" wrapText="true" styleClass="btn, btn-soft"/>
                        <Label text="Сохраняем выбранные детали. Минимумы ОЗУ/SSD зависят от задачи; неизвестные характеристики требуют проверки." wrapText="true" styleClass="config-summary-footnote"/>
                        <Button fx:id="addBuildToCart" text="Добавить товары в корзину" onAction="#addBuildToCart" maxWidth="Infinity" wrapText="true" styleClass="btn, btn-primary"/>
                        <ProgressIndicator fx:id="addProgress" visible="false" managed="false" prefWidth="22" prefHeight="22" maxWidth="22" maxHeight="22"/>
                        <Button text="Изменить бюджет" onAction="#toggleBudgetEditor" maxWidth="Infinity" styleClass="btn"/>
                        <HBox fx:id="budgetEditor" spacing="7" visible="false" managed="false">
                            <TextField fx:id="budgetField" promptText="Бюджет, ₽" minWidth="0" HBox.hgrow="ALWAYS" styleClass="config-budget-field"/>
                            <Button fx:id="applyBudgetButton" text="ОК" onAction="#saveBudget" styleClass="btn, btn-primary"/>
                        </HBox>
                        <Button fx:id="removeBudgetButton" text="Убрать ограничение бюджета" wrapText="true" minWidth="0" maxWidth="Infinity" onAction="#removeBudget" visible="false" managed="false" styleClass="config-clear-button"/>
                        <Label text="Имеющиеся детали не покупаются. Перед добавлением проверим цены и наличие" styleClass="config-summary-footnote" wrapText="true"/>

                    </VBox>
                    <VBox spacing="14" styleClass="config-checks-panel">
                        <Label text="Проверка совместимости" styleClass="config-checks-heading"/>
                        <VBox fx:id="findingsBox" spacing="13"/>
                    </VBox>
                </VBox>
            </GridPane>
        </VBox>
    </ScrollPane>
    <StackPane fx:id="overlayPane" visible="false" managed="false" styleClass="config-picker-overlay">
        <VBox maxWidth="820" maxHeight="650" spacing="17" styleClass="config-picker-dialog">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label fx:id="overlayTitle" text="Выбор компонента" styleClass="config-picker-heading"/>
                    <Label fx:id="pickerCount" text="Найдено: 0" styleClass="text-muted"/>
                </VBox>
                <Button fx:id="closeOverlayBtn" text="Закрыть" onAction="#closePicker" styleClass="btn"/>
            </HBox>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <TextField fx:id="pickerSearch" promptText="Поиск по названию или производителю" HBox.hgrow="ALWAYS" minWidth="0"/>
                <CheckBox fx:id="onlyAvailable" text="В наличии" selected="true"/>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="config-picker-scroll">
                <TilePane fx:id="overlayProductsGrid" prefColumns="3" hgap="12" vgap="12" alignment="TOP_LEFT"/>
            </ScrollPane>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button fx:id="clearSelectionBtn" text="Убрать компонент из сборки" onAction="#clearSelection" styleClass="btn"/>
                <Label text="Выбор изменяет только текущую сборку." styleClass="config-picker-footer" wrapText="true"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
