<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AuthController" fitToWidth="true" fitToHeight="true" styleClass="secondary-scroll" stylesheets="@styles/theme.css, @styles/secondary.css">
  <StackPane styleClass="auth-page" minHeight="560">
    <VBox maxWidth="460" maxHeight="-Infinity" spacing="20" styleClass="auth-form, surface">
      <VBox spacing="10"><Label text="ВАШ АККАУНТ" styleClass="secondary-eyebrow"/><Label fx:id="authTitle" text="Вход в TechStore" styleClass="page-title"/><Label fx:id="authSubTitle" text="Войдите, чтобы управлять корзиной и заказами." wrapText="true" styleClass="page-subtitle"/></VBox>
      <VBox spacing="8"><Label text="Email" styleClass="field-label"/><TextField fx:id="authEmail" promptText="you@example.com"/><Label text="Пароль" styleClass="field-label"/><PasswordField fx:id="authPassword" promptText="Введите пароль"/><Label fx:id="confirmLabel" text="Подтверждение пароля" visible="false" styleClass="field-label"/><PasswordField fx:id="authConfirmPassword" promptText="Повторите пароль" visible="false"/></VBox>
      <Label fx:id="authErrorLabel" wrapText="true" visible="false" styleClass="secondary-status"/>
      <Button fx:id="authSubmitBtn" text="Войти" maxWidth="Infinity" defaultButton="true" styleClass="btn, btn-primary"/>
      <Button fx:id="authSwitchBtn" text="Нет аккаунта? Зарегистрироваться" maxWidth="Infinity" styleClass="btn, btn-soft"/>
      <Button fx:id="authBackBtn" text="Вернуться в каталог" maxWidth="Infinity" styleClass="btn"/>
    </VBox>
  </StackPane>
</ScrollPane>
