<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManagerController" styleClass="secondary-page" stylesheets="@styles/theme.css, @styles/secondary.css">
 <top><VBox spacing="10" styleClass="secondary-page-heading"><Label text="РАБОЧЕЕ ПРОСТРАНСТВО" styleClass="secondary-eyebrow"/><HBox alignment="CENTER_LEFT" spacing="14"><Label text="Управление товарами" styleClass="page-title"/></HBox><Label fx:id="managerEmailLabel" text="Панель менеджера" styleClass="page-subtitle"/></VBox></top>
 <center><VBox spacing="16" styleClass="secondary-table-page"><FlowPane hgap="14" vgap="10"><Button fx:id="addProductBtn" text="Добавить товар" styleClass="btn, btn-primary"/><TextField fx:id="searchField" promptText="Поиск по названию, категории или бренду" prefWidth="320"/></FlowPane><Label fx:id="screenStatus" text="Каталог товаров" wrapText="true" styleClass="secondary-muted"/><TableView fx:id="productsTable" VBox.vgrow="ALWAYS"><placeholder><Label text="Товары не найдены" styleClass="secondary-muted"/></placeholder></TableView><Label text="Изменение цены, пополнение склада, фотография и архивирование доступны в строке товара." wrapText="true" styleClass="secondary-muted"/></VBox></center>
</BorderPane>
