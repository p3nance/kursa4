<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="rootBorderPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CabinetController" styleClass="secondary-page" stylesheets="@styles/theme.css, @styles/secondary.css">
  <top><VBox spacing="10" styleClass="secondary-page-heading"><Label text="ВАШ АККАУНТ" styleClass="secondary-eyebrow"/><HBox alignment="CENTER_LEFT" spacing="14"><Label text="Личный кабинет" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="logoutButton" text="Выйти" styleClass="btn"/></HBox><Label fx:id="userEmailLabel" text="Профиль и заказы" styleClass="page-subtitle"/></VBox></top>
  <center><ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="secondary-scroll"><VBox fx:id="mainContentVBox" spacing="22" styleClass="secondary-content">
    <VBox spacing="18" styleClass="surface, account-card"><Label text="Личные данные" styleClass="secondary-section-title"/><Label text="Контактные данные используются для связи по вашим заказам." wrapText="true" styleClass="secondary-muted"/>
      <GridPane hgap="18" vgap="18"><columnConstraints><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/><ColumnConstraints percentWidth="50" hgrow="ALWAYS"/></columnConstraints>
        <VBox spacing="7" GridPane.columnIndex="0" GridPane.rowIndex="0"><Label text="Email" styleClass="field-label"/><TextField fx:id="emailField" editable="false"/></VBox>
        <VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="0"><Label text="Имя" styleClass="field-label"/><TextField fx:id="nameField" promptText="Ваше имя"/></VBox>
        <VBox spacing="7" GridPane.columnIndex="0" GridPane.rowIndex="1"><Label text="Фамилия" styleClass="field-label"/><TextField fx:id="surnameField" promptText="Ваша фамилия"/></VBox>
        <VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="1"><Label text="Телефон" styleClass="field-label"/><TextField fx:id="phoneField" promptText="+7XXXXXXXXXX"/></VBox>
        <VBox spacing="7" GridPane.columnIndex="0" GridPane.rowIndex="2"><Label text="Город" styleClass="field-label"/><TextField fx:id="cityField" promptText="Ваш город"/></VBox>
        <VBox spacing="7" GridPane.columnIndex="1" GridPane.rowIndex="2"><Label text="Адрес" styleClass="field-label"/><TextField fx:id="addressField" promptText="Улица, дом, квартира"/></VBox>
      </GridPane>
      <Label fx:id="profileStatus" wrapText="true" visible="false" styleClass="secondary-status"/>
      <HBox spacing="12"><Button fx:id="saveButton" text="Сохранить изменения" styleClass="btn, btn-primary"/><Button fx:id="changePasswordButton" text="Изменить пароль" styleClass="btn"/></HBox>
    </VBox>
    <VBox spacing="13"><Label text="История заказов" styleClass="secondary-section-title"/><Label fx:id="ordersStatus" text="Загружаем историю заказов…" wrapText="true" styleClass="secondary-muted"/><VBox fx:id="ordersContainer" spacing="14"/></VBox>
  </VBox></ScrollPane></center>
</BorderPane>
