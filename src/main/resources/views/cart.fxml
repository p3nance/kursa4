<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CartController" styleClass="secondary-page" stylesheets="@styles/theme.css, @styles/secondary.css">
 <top><VBox spacing="10" styleClass="secondary-page-heading"><Label text="ВАШИ ПОКУПКИ" styleClass="secondary-eyebrow"/><Label text="Корзина" styleClass="page-title"/><Label fx:id="cartCountLabel" text="Выбранные товары появятся здесь" styleClass="page-subtitle"/></VBox></top>
 <center><ScrollPane fitToWidth="true" styleClass="secondary-scroll"><VBox spacing="18" styleClass="secondary-content"><Label fx:id="cartStatus" visible="false" wrapText="true" styleClass="secondary-status"/>
   <GridPane fx:id="cartGrid" hgap="22" vgap="22"><VBox fx:id="cartItemsContainer" spacing="12" GridPane.hgrow="ALWAYS"/>
   <VBox fx:id="cartSummary" GridPane.columnIndex="1" GridPane.valignment="TOP" maxWidth="480" spacing="18" styleClass="surface, cart-summary"><Label text="Сводка заказа" styleClass="secondary-section-title"/><Label text="Промокод" styleClass="field-label"/><HBox spacing="9"><TextField fx:id="promoCodeField" promptText="Введите код" HBox.hgrow="ALWAYS"/><Button fx:id="applyPromoButton" text="Применить" styleClass="btn"/></HBox><Label fx:id="discountLabel" text="Скидка: 0 ₽" visible="false" styleClass="secondary-success"/><Separator/><HBox alignment="CENTER_LEFT"><Label text="Итого" styleClass="secondary-section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" text="0 ₽" styleClass="cart-total"/></HBox><Button fx:id="checkoutButton" text="Проверить и оформить заказ" maxWidth="Infinity" styleClass="btn, btn-primary"/><Button fx:id="continueShopping" text="Продолжить покупки" maxWidth="Infinity" styleClass="btn"/><Label text="Итоговые цены, наличие и скидка проверяются при оформлении." wrapText="true" styleClass="secondary-muted"/></VBox></GridPane>
 </VBox></ScrollPane></center>
</BorderPane>
